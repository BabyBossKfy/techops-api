# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer le fichier .env.

ENVIRONMENT=development

# Secret de signature des jetons JWT : au moins 32 caractères aléatoires en production.
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
ACCESS_TOKEN_MINUTES=30

# Premier compte administrateur, créé au démarrage s'il n'existe pas.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-solide

# Mot de passe PostgreSQL utilisé par docker-compose.
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide

# Assistant IA : false = mode extractif (sans appel externe), true = réponses rédigées par Claude.
ASSISTANT_USE_LLM=false
ANTHROPIC_API_KEY=
